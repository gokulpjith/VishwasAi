# ==============================================================================
# Vishwas AI - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real API keys.
# ==============================================================================

# LLM Provider: "ollama", "groq", "openai", or "anthropic"
# ollama runs a local model. The others are hosted APIs.
LLM_PROVIDER=ollama

# Model name matching your provider:
# - Ollama: qwen2.5:7b, llama3.2:3b
# - Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b, llama-3.3-70b-versatile
# - OpenAI: gpt-4o, gpt-4o-mini
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
LLM_MODEL=qwen2.5:7b

# Local Ollama server. Used only when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Hosted LLM API key. Leave blank for Ollama. Required for groq, openai, and anthropic.
LLM_API_KEY=

# Tavily search key. If empty, search falls through to DuckDuckGo and then Wikipedia.
SEARCH_API_KEY=
